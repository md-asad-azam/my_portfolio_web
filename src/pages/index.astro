---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const socialLinks = [
  { label: 'Twitter / X', href: 'https://x.com/your-handle', icon: 'x' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/your-handle', icon: 'linkedin' },
  { label: 'GitHub', href: 'https://github.com/your-handle', icon: 'github' },
  { label: 'LeetCode', href: 'https://leetcode.com/u/your-handle', icon: 'leetcode' },
];
const resumeUrl = 'https://drive.google.com/file/d/your-resume-file-id/view';
---

<BaseLayout title="Asad — Software Developer" description="Portfolio of Asad, a software developer building dependable, high-performance digital systems.">
  <div class="grain"></div>
  <div class="cursor-light" aria-hidden="true"></div>
  <header class="nav shell">
    <a class="wordmark" href="#top" aria-label="Asad home">A<span>.</span></a>
    <nav aria-label="Primary navigation">
      <a href="#work">Work</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="availability" href="mailto:hello@asad.dev"><i></i> Available</a>
  </header>

  <main id="top">
    <section class="hero shell" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow reveal">Software developer · India</p>
        <h1 id="hero-heading" class="reveal delay-1">Quietly building<br /><em>fast things.</em></h1>
        <p class="role-cycle reveal delay-2"><span>// crafting</span> <strong data-role-cycle>software that matters</strong><i></i></p>
        <p class="intro reveal delay-2">I build thoughtful, high-performance software—from polished digital experiences to dependable backend systems and real-time infrastructure.</p>
        <div class="hero-actions reveal delay-3">
          <a class="button" href="#work">Explore my work <span>↘</span></a>
          <a class="text-link" href="#contact">Start a conversation <span>→</span></a>
          <a class="resume-link hero-resume" href={resumeUrl} target="_blank" rel="noreferrer">View résumé <span>↗</span></a>
        </div>
      </div>
      <div class="orbit" aria-hidden="true">
        <div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div>
        <div class="core"><span>01</span><small>latency<br/>is a feature</small></div>
        <div class="signal signal-a"></div><div class="signal signal-b"></div><div class="signal signal-c"></div>
      </div>
      <a class="scroll-cue" href="#work"><span></span> Scroll to explore</a>
    </section>

    <section id="work" class="work shell section">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <p class="section-note">A few systems I’ve shaped<br />from protocol to production.</p>
      </div>
      <div class="project-list">
        {projects.map((project) => (
          <article class="project">
            <div class="card-glow"></div>
            <div class="card-top"><span class="project-number">{project.number}</span><span class="status">Built to ship</span></div>
            <div class="project-main"><p>{project.type}</p><h2>{project.title}</h2></div>
            <p class="project-description">{project.description}</p>
            <div class="project-bottom"><div class="tags">{project.stack.map((item) => <span>{item}</span>)}</div><span class="arrow">↗</span></div>
          </article>
        ))}
      </div>
    </section>

    <section class="toolkit shell section" aria-labelledby="toolkit-heading">
      <div class="section-heading">
        <div><p class="eyebrow">Technical toolkit</p><h2 id="toolkit-heading">The tools behind<br /><em>the thinking.</em></h2></div>
        <p class="section-note">Strong systems start with<br />a well-chosen foundation.</p>
      </div>
      <div class="tech-cloud">
        <span class="tech-featured">C++</span><span>Python</span><span>FIX</span><span class="tech-featured">Linux</span><span>Kafka</span><span>Docker</span><span>CMake</span><span class="tech-featured">SBE</span><span>Git</span><span>PostgreSQL</span><span>REST APIs</span><span>Networking</span>
      </div>
    </section>

    <section id="about" class="about section">
      <div class="shell about-grid">
        <p class="eyebrow">About</p>
        <div><h2>Engineering the invisible parts that make everything else <em>feel effortless.</em></h2><p class="about-copy">My work lives at the seam between systems thinking and precise implementation. I enjoy untangling the complicated: data flows, execution paths, and the edge cases that appear once software meets the real world.</p><div class="capabilities"><span>C++ systems</span><span>Market data</span><span>Distributed systems</span><span>Developer experience</span></div></div>
      </div>
    </section>

    <section id="contact" class="contact shell section">
      <p class="eyebrow">Get in touch</p>
      <h2>Have a hard problem?<br /><em>Let’s make it move.</em></h2>
      <a class="email" href="mailto:hello@asad.dev">hello@asad.dev <span>↗</span></a>
      <footer>
        <span>© 2026 Asad</span>
        <div class="social-links" aria-label="Social profiles">
          {socialLinks.map((link) => (
            <a class="social-icon" href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label}>
              {link.icon === 'x' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2.3h3.7l-8.1 9.3 9.5 10.1h-7.4l-5.8-7.6-6.6 7.6H.5l8.7-9.9L.1 2.3h7.6l5.3 7 5.9-7Zm-1.3 17.5h2L6.6 4.1H4.4L17.6 19.8Z" /></svg>}
              {link.icon === 'linkedin' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3H3.5A1.5 1.5 0 0 0 2 4.5v15A1.5 1.5 0 0 0 3.5 21h17a1.5 1.5 0 0 0 1.5-1.5v-15A1.5 1.5 0 0 0 20.5 3ZM8 18H5V9h3v9ZM6.5 7.7A1.75 1.75 0 1 1 6.5 4a1.75 1.75 0 0 1 0 3.7ZM19 18h-3v-4.4c0-1.1 0-2.5-1.6-2.5s-1.8 1.2-1.8 2.4V18h-3V9h2.9v1.2h.1A3.2 3.2 0 0 1 15.5 8.8c3 0 3.5 1.9 3.5 4.5V18Z" /></svg>}
              {link.icon === 'github' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.3-.2-4.7-1.2-4.7-5.2 0-1.1.4-2.1 1-2.8-.1-.3-.4-1.4.1-2.8 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.5 1.4.2 2.5.1 2.8.6.7 1 1.7 1 2.8 0 4-2.4 5-4.7 5.2.4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A10.2 10.2 0 0 0 22 12.2C22 6.6 17.5 2 12 2Z" /></svg>}
              {link.icon === 'leetcode' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 3 3.1 3.1-1.5 1.5L12.9 5.9 7.1 11.7a2 2 0 0 0 0 2.8l3.3 3.3a2 2 0 0 0 2.8 0l1.8-1.8 1.5 1.5-1.8 1.8a4.1 4.1 0 0 1-5.8 0l-3.3-3.3a4.1 4.1 0 0 1 0-5.8L11.4 4.4 13 3Zm2.2 7.7H9.7v2.1h5.5v-2.1Z" /></svg>}
            </a>
          ))}
        </div>
        <a href="#top">Back to top ↑</a>
      </footer>
    </section>
  </main>
  <script>
    import Lenis from 'lenis';

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const lenis = new Lenis({
        duration: 1.15,
        smoothWheel: true,
        lerp: 0.09,
        anchors: true,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      const cursorLight = document.querySelector<HTMLElement>('.cursor-light');
      let pointerX = window.innerWidth / 2;
      let pointerY = window.innerHeight / 2;
      let cursorFrame = 0;
      window.addEventListener('pointermove', (event) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
        if (!cursorFrame) {
          cursorFrame = requestAnimationFrame(() => {
            cursorLight?.style.setProperty('--cursor-x', `${pointerX}px`);
            cursorLight?.style.setProperty('--cursor-y', `${pointerY}px`);
            cursorFrame = 0;
          });
        }
      });

      const revealTargets = document.querySelectorAll<HTMLElement>('.section-heading, .project, .tech-cloud, .about-grid > *, .contact > *');
      revealTargets.forEach((target) => target.classList.add('scroll-reveal'));
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealTargets.forEach((target) => observer.observe(target));

      const roleCycle = document.querySelector<HTMLElement>('[data-role-cycle]');
      const roles = ['software that matters', 'reliable backend systems', 'human-first digital experiences', 'real-time infrastructure'];
      let roleIndex = 0;
      let characterIndex = 0;
      let isDeleting = false;
      function typeRole() {
        if (!roleCycle) return;
        const role = roles[roleIndex];
        roleCycle.textContent = role.slice(0, characterIndex);
        if (!isDeleting && characterIndex < role.length) {
          characterIndex += 1;
          window.setTimeout(typeRole, 58 + Math.random() * 45);
        } else if (!isDeleting) {
          isDeleting = true;
          window.setTimeout(typeRole, 1450);
        } else if (characterIndex > 0) {
          characterIndex -= 1;
          window.setTimeout(typeRole, 28);
        } else {
          isDeleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          window.setTimeout(typeRole, 320);
        }
      }
      characterIndex = 0;
      typeRole();

      document.querySelectorAll<HTMLElement>('.project').forEach((card) => {
        let animationFrame = 0;
        let tiltX = 0;
        let tiltY = 0;
        const updateTilt = () => {
          card.style.setProperty('--tilt-x', `${tiltY * -24}deg`);
          card.style.setProperty('--tilt-y', `${tiltX * 26}deg`);
          card.style.setProperty('--move-x', `${tiltX * 18}px`);
          card.style.setProperty('--move-y', `${tiltY * 14}px`);
          animationFrame = 0;
        };
        card.addEventListener('pointermove', (event) => {
          const bounds = card.getBoundingClientRect();
          tiltX = (event.clientX - bounds.left) / bounds.width - 0.5;
          tiltY = (event.clientY - bounds.top) / bounds.height - 0.5;
          if (!animationFrame) animationFrame = requestAnimationFrame(updateTilt);
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--tilt-x', '0deg');
          card.style.setProperty('--tilt-y', '0deg');
          card.style.setProperty('--move-x', '0px');
          card.style.setProperty('--move-y', '0px');
        });
      });
    }
  </script>
</BaseLayout>
